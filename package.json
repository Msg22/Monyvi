{
  "name": "monyvi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monyvi - Offline-first money tracking, live rates, and inflation guidance for Egypt",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run expo-install -w @monyvi/mobile",
    "api:dev": "npm run dev -w @monyvi/api",
    "api:build": "npm run build -w @monyvi/api",
    "mobile": "npm run start -w @monyvi/mobile",
    "supabase:start:local": "node scripts/start-local-supabase.js",
    "mobile:local-supabase": "npm run start:local-supabase -w @monyvi/mobile --",
    "mobile:local-supabase:wireless-device": "npm run start:local-supabase:wireless-device -w @monyvi/mobile --",
    "mobile:e2e-fixture": "npm run start:e2e-fixture -w @monyvi/mobile",
    "mobile:ios": "npm run ios -w @monyvi/mobile",
    "mobile:android": "npm run android -w @monyvi/mobile",
    "mobile:android:release": "npm run android:release -w @monyvi/mobile",
    "mobile:android-local-build": "npm run android-local-build -w @monyvi/mobile",
    "mobile-prebuild": "npm run prebuild -w @monyvi/mobile",
    "mobile:doctor": "npm run doctor -w @monyvi/mobile",
    "mobile:install-check": "npm run install-check -w @monyvi/mobile",
    "local:reset-and-seed": "npm run db:reset && cross-env MANUAL_QA_PASSWORD=MonyviLocalQA123 npm run manual:seed-user -w @monyvi/mobile",
    "lint": "eslint . --rulesdir scripts/eslint-rules --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --rulesdir scripts/eslint-rules --ext .ts,.tsx,.js,.jsx --fix",
    "test:eslint-rules": "node -e \"const fs=require('fs'); for (const f of fs.readdirSync('scripts/eslint-rules').filter((name)=>name.endsWith('.test.js'))) require('./scripts/eslint-rules/'+f)\"",
    "test:scripts": "node --test scripts/*.test.js",
    "android": "expo run:android",
    "start:android": "npm run start -w @monyvi/mobile",
    "ios": "expo run:ios",
    "db:types": "npx supabase gen types typescript --project-id yulbcndyssdjicbpmlrk > packages/db/src/supabase-types.ts",
    "db:format-types": "npx prettier --write packages/db/src/supabase-types.ts",
    "db:transform": "node scripts/transform-schema.js",
    "db:sync": "npm run db:types && npm run db:format-types && npm run db:transform",
    "db:watermelon-migrate": "node scripts/sql-to-watermelon-migration.js",
    "db:migrate": "npm run db:push -- --include-all && npm run db:sync-local",
    "db:sync-local": "npm run db:watermelon-migrate -- --latest && npm run db:sync",
    "db:pull": "npx supabase db pull",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:migrations": "npx supabase migration list",
    "supabase:runtime:setup-local": "node scripts/setup-local-supabase-runtime.js",
    "supabase:market-rates:import-local": "node scripts/import-market-rates-to-local.js",
    "fn:deploy:rates": "npx supabase functions deploy fetch-metal-rates --project-ref yulbcndyssdjicbpmlrk",
    "fn:deploy:parse-sms": "npx supabase functions deploy parse-sms --project-ref yulbcndyssdjicbpmlrk",
    "fn:deploy:parse-voice": "npx supabase functions deploy parse-voice --project-ref yulbcndyssdjicbpmlrk",
    "e2e": "npm run e2e -w @monyvi/mobile",
    "e2e:ci": "npm run e2e:ci -w @monyvi/mobile",
    "e2e:seed": "npm run e2e:seed -w @monyvi/mobile",
    "e2e:reset": "npm run e2e:reset -w @monyvi/mobile",
    "e2e:local": "npm run e2e:local -w @monyvi/mobile",
    "e2e:flow": "npm run e2e:flow -w @monyvi/mobile --",
    "e2e:flow:local": "npm run e2e:flow:local -w @monyvi/mobile --",
    "e2e:auth:local": "npm run e2e:auth:local -w @monyvi/mobile",
    "e2e:sms-sync": "npm run e2e:sms-sync -w @monyvi/mobile --",
    "e2e:sms-sync:local": "npm run e2e:sms-sync:local -w @monyvi/mobile --",
    "e2e:live-sms": "npm run e2e:live-sms -w @monyvi/mobile --",
    "e2e:live-sms:local": "npm run e2e:live-sms:local -w @monyvi/mobile --",
    "e2e:device": "npm run e2e:device -w @monyvi/mobile --",
    "e2e:studio": "npm run e2e:studio -w @monyvi/mobile",
    "test": "npm test -w @monyvi/mobile",
    "prepare": "node -e \"if (process.env.CI !== 'true') { process.exit(1) }\" || husky",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.28.0"
  },
  "devDependencies": {
    "@nx/eslint": "22.7.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.5.2",
    "nx": "22.7.6",
    "prettier": "^3.2.5",
    "supabase": "^2.103.0",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.27.0"
  }
}
